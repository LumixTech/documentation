# =====================================================================
# Apicurio Registry — ortam değişkenleri ÖRNEĞİ.
# Kullanım:  cp .env.example .env   → sonra .env içindeki şifreyi değiştir.
# .env ASLA commit edilmez (bkz. repo .gitignore: .env, .env.*).
# =====================================================================

# --- Sürümler (pinlenmiş; keyfe göre yükseltmeyin, önce test edin) ---
APICURIO_VERSION=3.3.0
POSTGRES_VERSION=17

# --- PostgreSQL ---
POSTGRES_USER=apicurio
POSTGRES_DB=apicurio
# ZORUNLU: güçlü bir şifre üretin, örn:  openssl rand -base64 24
POSTGRES_PASSWORD=degistir-beni-guclu-bir-sifre
# Postgres yalnızca localhost'a map'lenir (compose'da 127.0.0.1 sabit).
POSTGRES_PORT=5432

# --- Registry API ---
APICURIO_API_PORT=8080
# Tarayıcı UI'sinin API'ye erişebilmesi için CORS origin.
# ÜRETİM: "*" yerine UI origin'ini yazın, örn: https://schema.lumix.example
APICURIO_CORS_ORIGINS=*

# --- Web konsolu (UI) ---
APICURIO_UI_PORT=8888
# UI'nin tarayıcıdan çağıracağı API adresi (sunucuda dış URL olmalı).
# Lokal geliştirme:
APICURIO_UI_API_URL=http://localhost:8080/apis/registry/v3
# Sunucu örneği (reverse proxy arkasında):
# APICURIO_UI_API_URL=https://schema.lumix.example/apis/registry/v3
