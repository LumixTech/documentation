# --- IDE (.idea): sadece paylasilabilir kisimlari check-in et ---
/.idea/*
!/.idea/codeStyles/
!/.idea/externalDependencies.xml
!/.idea/inspectionProfiles/

# --- Build ciktilari ---
build/
# NOT: IntelliJ cikti klasoru sadece kokte; anchor'sız "out/" hexagonal
# "port/out" kaynak paketini de yok sayiyordu (CI derleme hatasi). Bu yuzden /out/.
/out/
target/
.gradle/

# --- Node / frontend ---
node_modules/
dist/
.pnpm-store/

# --- Protobuf uretilen kod (gerekirse acin) ---
# generated/

# --- Log ---
*.log

